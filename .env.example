# Copy this file to .env and fill in your real keys.
# Never commit the real .env to version control.

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# TikTok Content Posting API — requires an approved TikTok developer app
# with the video.publish / content posting scope.
# https://developers.tiktok.com/
TIKTOK_ACCESS_TOKEN=

# Supabase — Project Settings -> API in your Supabase dashboard
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=media
